    {
      "name": "Desktop Feature Copy",
      "kind": "custom",
      "refersTo": "desktop-feature",
      "description": "Paper copy below the complete fitted illustration; compact two-column arrangement adapts at 1350px. Artwork is outside this specimen.",
      "html": "<div class=\"ds-feature-copy\"><h2>有些靠近，<br>從普通的一天開始。</h2><p>同學 · 日常</p><div class=\"ds-feature-bond\">相識 <progress value=\"20\" max=\"100\" aria-label=\"好感\"></progress></div><button>看看這位同學</button></div>",
      "css": ".ds-feature-copy{padding:18px 24px 20px;background:#f4f8ea;color:#213f32;display:grid;grid-template-columns:minmax(0,1fr) auto;gap:10px 18px;align-items:center;font-family:\"Noto Sans TC\",sans-serif}.ds-feature-copy h2{grid-column:1;grid-row:1;font-family:\"Noto Serif TC\",serif;font-size:24px;line-height:1.45;letter-spacing:-.025em;margin:0}.ds-feature-copy p{grid-column:1;grid-row:2;margin:0;font-size:14px;line-height:1.85}.ds-feature-bond{grid-column:2;grid-row:1;width:210px;font-size:12px}.ds-feature-bond progress{width:100%;accent-color:#285c49}.ds-feature-copy button{grid-column:2;grid-row:2;justify-self:end;min-height:42px;padding:10px 14px;background:#fbfcf7;color:#233e34;border:1px solid #cbd7c9;border-radius:10px;font:inherit;cursor:pointer;transition:background .18s,color .18s}.ds-feature-copy button:hover{background:#e1eadd;color:#1c4031}.ds-feature-copy button:focus-visible{outline:3px solid #a0533e;outline-offset:3px}@media(max-width:1350px){.ds-feature-copy{padding:16px 20px;grid-template-columns:1fr 1fr}.ds-feature-copy h2{grid-column:1/-1;font-size:22px}.ds-feature-copy p{grid-column:1/-1}.ds-feature-bond{grid-column:1;grid-row:3;width:100%}.ds-feature-copy button{grid-column:2;grid-row:3;font-size:12px}}"

      "css": ".ds-nav{display:flex;gap:10px;background:#fbfcf7;border-bottom:1px solid #cbd7c9}.ds-nav button{font-family:\"Noto Sans TC\",sans-serif;color:#233e34;background:transparent;border:0;padding:9px 10px;min-height:42px;font-size:11px;cursor:pointer}.ds-nav button[aria-current]{color:#285c49;border-bottom:3px solid #285c49;font-weight:700}.ds-nav button:hover{background:#e1eadd}.ds-nav button:focus-visible{outline:3px solid #a0533e;outline-offset:3px}"

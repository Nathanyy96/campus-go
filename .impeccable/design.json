      "html": "<button class=\"ds-app\"><span><svg viewBox=\"0 0 24 24\" width=\"27\" height=\"27\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\"><path d=\"M5 4h14v13H9l-4 3V4Z\"/><path d=\"M8 8h8M8 12h6\"/></svg></span>訊息</button>",
      "css": ".ds-app{font-family:\"Noto Sans TC\",sans-serif;color:#233e34;display:grid;justify-items:center;gap:9px;background:transparent;border:0;font-size:12px;cursor:pointer}.ds-app span{display:grid;place-items:center;width:58px;height:58px;background:#dfeadd;color:#285c49;border-radius:16px}.ds-app:hover span{background:#e1eadd}.ds-app:focus-visible{outline:3px solid #a0533e;outline-offset:3px}"
